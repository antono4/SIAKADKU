{
  "name": "siakad-terpadu",
  "version": "2.0.0",
  "private": true,
  "description": "Sistem Informasi Akademik Terpadu (SIAKAD) — modern edition. NestJS + Next.js + PostgreSQL.",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter backend db:generate",
    "db:migrate": "pnpm --filter backend db:migrate deploy",
    "db:seed": "pnpm --filter backend db:seed"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
